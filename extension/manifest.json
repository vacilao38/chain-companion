{
  "manifest_version": 3,
  "name": "Chain Companion",
  "version": "1.0.0",
  "description": "Guarde links no Chain por uma janela rápida, sem enviar sua biblioteca à internet.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "contextMenus"
  ],
  "host_permissions": [
    "https://vacilao38.github.io/clustter-cores-downloads/*"
  ],
  "action": {
    "default_title": "Guardar no Chain",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
